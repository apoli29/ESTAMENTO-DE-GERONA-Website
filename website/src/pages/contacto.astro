---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Venera from '../components/Venera.astro';
import contacto from '../data/contacto.json';
import { foto, CREDITOS } from '../lib/sitio';
---
<Base titulo="Contacto">
  <!-- La página se abre sobre la ciudad: la fotografía a sangre y el correo encima, en claro -->
  <section class="seccion contacto banda-negra sobre-negro" aria-labelledby="contacto-titulo">
    <Image class="contacto__foto" src={foto('onyar-catedral.jpg')} alt="El Onyar y la Catedral de Gerona" widths={[960, 1600, 2400]} sizes="100vw" quality={86} loading="eager" fetchpriority="high" />
    <div class="contacto__velo" aria-hidden="true"></div>
    <div class="envoltura capitulo contacto__caja">
      <div class="rotulo">
        <span class="rotulo__etiqueta">Contacto</span>
        <Venera tamano={64} clase="contacto__venera" />
      </div>
      <div class="contacto__texto">
        <h1 id="contacto-titulo" class="t-display">{contacto.titulo}</h1>
        <p class="t-entradilla">{contacto.texto}</p>
        <a class="contacto__email" href={`mailto:${contacto.email}`}>{contacto.email}</a>
      </div>
    </div>
    <p class="contacto__credito t-dato">{CREDITOS['onyar-catedral.jpg']}</p>
  </section>
</Base>

<style>
  .contacto { position: relative; min-height: 80svh; display: grid; align-content: center; overflow: hidden; }
  .contacto :global(.contacto__foto) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 58%; }
  /* En estrecho el texto ocupa todo el ancho, así que el velo sólo puede ser vertical.
     A partir de 900 px entra el de costado: hunde el lado del texto y deja respirar la
     fotografía a la derecha. */
  .contacto__velo {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(26, 23, 20, .74) 0%, rgba(26, 23, 20, .6) 40%, rgba(26, 23, 20, .9) 100%);
  }
  @media (min-width: 900px) {
    .contacto__velo {
      background:
        linear-gradient(100deg, rgba(26, 23, 20, .93) 0%, rgba(26, 23, 20, .74) 48%, rgba(26, 23, 20, .34) 100%),
        linear-gradient(180deg, rgba(26, 23, 20, .5) 0%, rgba(26, 23, 20, .28) 44%, rgba(26, 23, 20, .82) 100%);
    }
  }
  .contacto__caja { position: relative; }
  .contacto :global(.contacto__venera) { margin-top: var(--s6); }
  .contacto__texto { display: grid; gap: var(--s6); }
  .contacto__email {
    font-family: var(--f-titulo); font-weight: 500; font-size: clamp(20px, 5.4vw, 46px); line-height: 1.2;
    color: var(--pergamino); text-decoration-color: var(--teja); text-underline-offset: 8px; overflow-wrap: anywhere;
  }
  .contacto__email:hover { color: var(--espada); }
  .contacto__credito { position: absolute; left: var(--margen); right: var(--margen); bottom: var(--s5); color: var(--plata); }
</style>
