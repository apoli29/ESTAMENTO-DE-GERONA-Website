---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { metaPagina } from '../lib/pageMeta';
import Venera from '../components/Venera.astro';
import contacto from '../data/contacto.json';
import { foto } from '../lib/sitio';
---
<Base meta={metaPagina("/contacto/")}>
  <!-- La página se abre sobre la ciudad: la fotografía a sangre y el correo encima, en claro -->
  <section class="seccion contacto banda-negra sobre-negro" aria-labelledby="contacto-titulo">
    <Image class="contacto__foto" src={foto('catedral-jardin.jpg')} alt="La Catedral de Gerona al atardecer" widths={[960, 1600, 2400, 3200]} sizes="100vw" quality={86} loading="eager" fetchpriority="high" />
    <div class="contacto__velo" aria-hidden="true"></div>
    <div class="envoltura capitulo contacto__caja">
      <div class="rotulo">
        <span class="rotulo__etiqueta">Contacto</span>
        <Venera tamano={64} clase="contacto__venera" />
      </div>
      <div class="contacto__texto">
        <h1 id="contacto-titulo" class="t-display">{contacto.titulo}</h1>
        <p class="t-entradilla">{contacto.texto}</p>
        <a class="contacto__email" href={`mailto:${contacto.email}`}>{contacto.email}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .contacto { position: relative; min-height: calc(var(--ventana) * 80); display: grid; align-content: center; overflow: hidden; }
  .contacto :global(.contacto__foto) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 30% 50%; }
  /* En estrecho la foto se recorta a lo alto: el encuadre se corre a la izquierda, a la Catedral */
  /* El velo manda: la fotografía es fondo y el texto tiene que leerse entero en cualquier punto.
     En estrecho el texto ocupa todo el ancho, así que el velo sólo puede ser vertical; a partir
     de 900 px entra además el de costado, más denso del lado del texto. */
  .contacto__velo {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(26, 23, 20, .86) 0%, rgba(26, 23, 20, .8) 40%, rgba(26, 23, 20, .94) 100%);
  }
  @media (min-width: 900px) {
    .contacto__velo {
      background:
        linear-gradient(100deg, rgba(26, 23, 20, .95) 0%, rgba(26, 23, 20, .86) 48%, rgba(26, 23, 20, .62) 100%),
        linear-gradient(180deg, rgba(26, 23, 20, .55) 0%, rgba(26, 23, 20, .35) 44%, rgba(26, 23, 20, .85) 100%);
    }
  }
  .contacto__caja { position: relative; }
  .contacto :global(.contacto__venera) { margin-top: var(--s6); }
  .contacto__texto { display: grid; gap: var(--s6); }
  .contacto__email {
    font-family: var(--f-titulo); font-weight: 500; font-size: clamp(20px, 5.4vw, 46px); line-height: 1.2;
    color: var(--pergamino); text-decoration-color: var(--teja); text-underline-offset: 8px; overflow-wrap: anywhere;
  }
  .contacto__email:hover { color: var(--espada); }
</style>
