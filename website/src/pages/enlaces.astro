---
import Base from '../layouts/Base.astro';
import enlaces from '../data/enlaces.json';
const limpio = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<Base titulo="Enlaces">
  <section class="seccion">
    <div class="envoltura capitulo">
      <div class="rotulo">
        <span class="rotulo__etiqueta">Enlaces</span>
      </div>
      <div class="enl">
        <h1 class="t-display">Enlaces</h1>
        {enlaces.map((g) => (
          <section class="enl__grupo">
            {g.grupo && <h2 class="t-etiqueta enl__titulo">{g.grupo.replace(/:$/, '')}</h2>}
            <ul class="enl__lista">
              {g.enlaces.map((e) => (
                <li>
                  <a class="enl__enlace" href={e.url} rel="noopener" target="_blank">
                    <span class="enl__nombre">{e.nombre}</span>
                    <span class="enl__url t-dato">{limpio(e.url)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .enl { display: grid; gap: var(--s7); }
  .enl__titulo { margin-bottom: var(--s3); }
  .enl__lista { list-style: none; border-top: 1px solid var(--negro); }
  .enl__lista li { border-bottom: 1px solid var(--linea); }
  .enl__enlace { display: grid; gap: var(--s1) var(--s5); padding: var(--s4) 0; color: var(--negro); text-decoration: none; }
  @media (min-width: 820px) { .enl__enlace { grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; } }
  .enl__nombre { font-family: var(--f-texto); font-size: 19px; line-height: 1.4; text-wrap: pretty; }
  .enl__url { color: var(--tinta-2); }
  .enl__enlace:hover .enl__nombre { color: var(--teja); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
</style>
