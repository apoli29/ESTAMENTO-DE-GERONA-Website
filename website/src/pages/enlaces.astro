---
import Base from '../layouts/Base.astro';
import enlaces from '../data/enlaces.json';
const limpio = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
// El primer bloque viene sin grupo en los datos: es un enlace suelto y se presenta aparte,
// con el enlace mayor del sistema. Los demás son capítulos con su rótulo al costado.
const suelto = enlaces.find((g) => !g.grupo);
const grupos = enlaces.filter((g) => g.grupo);
---
<Base titulo="Enlaces">
  <section class="seccion banda-negra sobre-negro cabeza-pagina">
    <div class="envoltura capitulo">
      <div class="rotulo">
        <span class="rotulo__etiqueta">Enlaces</span>
      </div>
      <h1 class="t-display">Enlaces</h1>
    </div>
  </section>

  {suelto && (
    <section class="seccion banda-piedra">
      <div class="envoltura capitulo">
        <div class="columna-vacia" aria-hidden="true"></div>
        <div class="suelto">
          {suelto.enlaces.map((e) => (
            <p class="suelto__fila">
              <a class="enlace-mayor" href={e.url} rel="noopener" target="_blank">{e.nombre}</a>
              <span class="t-dato suelto__url">{limpio(e.url)}</span>
            </p>
          ))}
        </div>
      </div>
    </section>
  )}

  {grupos.map((g, i) => (
    <section class="seccion" aria-labelledby={`grupo-${i}`}>
      <div class="envoltura capitulo capitulo--fijo">
        <div class="rotulo">
          <h2 id={`grupo-${i}`} class="rotulo__nombre">{g.grupo!.replace(/:$/, '')}</h2>
        </div>
        <ul class="enl__lista">
          {g.enlaces.map((e) => (
            <li class="enl__item">
              <a class="enl__enlace" href={e.url} rel="noopener" target="_blank">
                <span class="enl__nombre">{e.nombre}</span>
                <span class="enl__url t-dato">{limpio(e.url)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Base>

<style>
  /* Enlace suelto: el único que no pertenece a ningún grupo, con la espada del sistema.
     La dirección se sangra el hueco que la espada deja a su izquierda, para caer bajo el texto. */
  .suelto__fila { display: grid; gap: var(--s2); justify-items: start; }
  .suelto__url { color: var(--tinta-2); padding-left: calc(42px + 16px); }

  .enl__lista { list-style: none; border-top: 1px solid var(--negro); }
  .enl__item { border-bottom: 1px solid var(--linea); }
  .enl__enlace {
    position: relative; display: grid; gap: var(--s1) var(--s5);
    padding: var(--s4) var(--s6) var(--s4) 0;
    color: var(--negro); text-decoration: none;
  }
  @media (min-width: 820px) {
    .enl__enlace { grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; }
  }
  /* El nombre avanza al apuntar: se mueve con transform, no con el relleno, para no rehacer
     la retícula de veintitrés filas en cada paso del ratón. */
  .enl__nombre {
    font-family: var(--f-titulo); font-weight: 500; font-size: 22px; line-height: 1.2; letter-spacing: -.01em; text-wrap: pretty;
    transition: transform .5s cubic-bezier(.2, .7, .1, 1), color .3s ease;
  }
  /* En estrecho la dirección puede partirse: entera, alguna es más ancha que un móvil */
  .enl__url { color: var(--tinta-2); overflow-wrap: anywhere; }
  @media (min-width: 820px) { .enl__url { white-space: nowrap; } }

  /* La espada marca que el enlace sale fuera del sitio: entra desde la izquierda al apuntar */
  .enl__enlace::after {
    content: ''; position: absolute; right: 0; top: calc(var(--s4) + .55em - 6px);
    width: 26px; height: 12px; background: var(--teja);
    -webkit-mask: var(--espada-h) center / contain no-repeat;
    mask: var(--espada-h) center / contain no-repeat;
    opacity: 0; transform: translateX(-10px);
    transition: opacity .3s ease, transform .5s cubic-bezier(.2, .7, .1, 1);
  }
  .enl__enlace:hover .enl__nombre, .enl__enlace:focus-visible .enl__nombre {
    color: var(--teja); transform: translateX(var(--s4));
  }
  .enl__enlace:hover::after, .enl__enlace:focus-visible::after { opacity: 1; transform: none; }
  .enl__enlace:focus-visible { outline-offset: -2px; }

  /* Sin movimiento, el color y la espada siguen marcando el enlace apuntado */
  @media (prefers-reduced-motion: reduce) {
    .enl__enlace:hover .enl__nombre, .enl__enlace:focus-visible .enl__nombre { transform: none; }
    .enl__enlace::after { transform: none; }
  }
</style>
