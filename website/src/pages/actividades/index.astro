---
import Base from '../../layouts/Base.astro';
import ActividadTarjeta from '../../components/ActividadTarjeta.astro';
import { actividades, porAnio, FILTROS } from '../../lib/sitio';
const anios = porAnio(actividades);
---
<Base titulo="Actividades">
  <section class="seccion banda-negra sobre-negro cabeza-pagina encabezado">
    <div class="envoltura capitulo">
      <div class="rotulo">
        <span class="rotulo__etiqueta">Anales</span>
        <p class="t-dato t-secundario">{anios[anios.length - 1][0]} — {anios[0][0]}</p>
      </div>
      <div class="encabezado__texto">
        <h1 class="t-display">Actividades</h1>
        <div class="filtros" role="group" aria-label="Filtrar por tipo">
          {FILTROS.map((f, i) => (
            <>
              {i > 0 && <span class="filtros__cruz" aria-hidden="true"></span>}
              <button class="filtros__boton" type="button" data-filtro={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.nombre}</button>
            </>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="envoltura anales" data-anales>
    {anios.map(([anio, lista]) => (
      <section class="anio" data-anio={anio} aria-labelledby={`anio-${anio}`}>
        <h2 id={`anio-${anio}`} class="anio__titulo">{anio}</h2>
        <ul class="anio__lista">
          {lista.map((a) => <ActividadTarjeta a={a} />)}
        </ul>
      </section>
    ))}
    <p class="anales__vacio t-secundario" hidden data-vacio>No hay actividades de este tipo.</p>
  </div>
</Base>

<script>
  const botones = document.querySelectorAll<HTMLButtonElement>('.filtros__boton');
  const filas = document.querySelectorAll<HTMLElement>('.tarjeta');
  const anios = document.querySelectorAll<HTMLElement>('[data-anio]');
  function aplicar(f: string) {
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === f)));
    filas.forEach((li) => { li.hidden = f !== 'todas' && li.dataset.filtro !== f; });
    let visibles = 0;
    anios.forEach((s) => { const hay = [...s.querySelectorAll<HTMLElement>('.tarjeta')].some((li) => !li.hidden); s.hidden = !hay; if (hay) visibles++; });
    document.querySelector<HTMLElement>('[data-vacio]')!.hidden = visibles > 0;
    const url = new URL(location.href);
    if (f === 'todas') url.searchParams.delete('tipo'); else url.searchParams.set('tipo', f);
    history.replaceState(null, '', url);
  }
  botones.forEach((b) => b.addEventListener('click', () => aplicar(b.dataset.filtro!)));
  const inicial = new URL(location.href).searchParams.get('tipo');
  if (inicial && [...botones].some((b) => b.dataset.filtro === inicial)) aplicar(inicial);
</script>

<style>
  .encabezado { padding-bottom: var(--s7); }
  .encabezado__texto { display: grid; gap: var(--s6); }
  /* Mini barra de navegación: filetes arriba y abajo, opciones separadas por la cruz.
     Va sobre la banda negra, así que el filete es claro y la opción activa se distingue
     por el color del texto, no sólo por la marca roja de abajo. */
  .filtros {
    display: flex; align-items: center; gap: var(--s5);
    border-top: 1px solid var(--linea-clara); border-bottom: 1px solid var(--linea-clara);
    overflow-x: auto; scrollbar-width: none;
  }
  .filtros::-webkit-scrollbar { display: none; }
  .filtros__boton {
    position: relative; flex: none; min-height: 52px; padding: 0; cursor: pointer;
    background: none; border: 0; color: var(--plata);
    font: 400 13px/16px var(--f-cuerpo); letter-spacing: .16em; text-transform: uppercase;
    transition: color .3s ease;
  }
  /* Marca de la opción activa: se apoya sobre el filete inferior */
  .filtros__boton::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--rojo);
    transform: scaleX(0); transition: transform .5s cubic-bezier(.16, 1, .3, 1);
  }
  .filtros__boton:hover, .filtros__boton[aria-pressed='true'] { color: var(--pergamino); }
  .filtros__boton[aria-pressed='true']::after { transform: scaleX(1); }
  .filtros__boton:focus-visible { outline-offset: -2px; }
  .filtros__cruz { flex: none; width: 7px; height: 7px; background: var(--cruz) center / contain no-repeat; }

  /* Años en vertical; las actividades de cada año, en horizontal */
  .anales { padding-bottom: var(--entre-secciones); }
  .anio { display: grid; gap: var(--s6); padding: var(--s6) 0 var(--s8); border-top: 1px solid var(--negro); }
  .anio__titulo { font-family: var(--f-titulo); font-weight: 800; font-size: var(--h1); line-height: 1.08; letter-spacing: -.03em; color: var(--castano); }
  .anio__lista { list-style: none; display: grid; gap: var(--s7) var(--medianil); grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); }
  .anales__vacio { padding: var(--s7) 0; }
</style>
