---
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
interface Props { titulo?: string; lang?: string }
const { titulo, lang = 'es' } = Astro.props;
const nombre = 'Real Estamento Militar del Principado de Gerona';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo ? `${titulo} · ${nombre}` : `${nombre} · Cofradía de San Jorge`}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2B1F18" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@400;500;600;700;800&family=Thasadith:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Cabecera />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
    <script>
      // Desplazamiento suave y algo más lento que el nativo (≈20 %), para un ritmo pausado.
      import Lenis from 'lenis';
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({ lerp: 0.08, wheelMultiplier: 0.8, anchors: { offset: -96 }, autoRaf: true });
        (window as any).lenis = lenis;
      }

      // Momento único de la venera: las espadas se recogen al entrar en pantalla.
      const veneras = document.querySelectorAll('[data-venera]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entradas) => {
          for (const e of entradas) if (e.isIntersecting) { e.target.classList.add('esta-visible'); io.unobserve(e.target); }
        }, { threshold: 0.45 });
        veneras.forEach((v) => io.observe(v));
      } else veneras.forEach((v) => v.classList.add('esta-visible'));

      // Animaciones básicas: los bloques de contenido aparecen suavemente al entrar en pantalla,
      // escalonados cuando entran varios a la vez.
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        // Todo lo que es un bloque de contenido entra en la escena. Los párrafos del texto
        // íntegro quedan fuera a propósito: son cientos y es una página para leer, no para mirar.
        const SELECTOR = [
          '.rotulo', '.t-display', '.t-entradilla', '.t-titulo2', '.t-cuerpo', '.cita', '.origen__texto', '.origen__pie',
          '.relacion__fila', '.distintivos__col', '.caja', '.tarjeta', '.navidad__item', '.figura', '.filtros', '.anio__titulo',
          '.consejo__honor-item', '.consejo__miembro', '.libros__item', '.disp__item', '.clases__item', '.boton', '.enlace-mayor',
          '.placa', '.documento', '.enl__item', '.legal__h', '.legal__lista', '.vecinos__enlace',
          '.libro__cabeza', '.libro__capitulo',
        ].map((s) => 'main ' + s).join(',');
        const todos = [...document.querySelectorAll<HTMLElement>(SELECTOR)]
          .filter((el) => !el.closest('.portada, .hportada'));
        const elegidos = todos.filter((el) => !todos.some((otro) => otro !== el && otro.contains(el)));
        const io = new IntersectionObserver((entradas) => {
          let i = 0;
          for (const e of entradas) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            el.style.setProperty('--retraso', Math.min(i++ * 80, 480) + 'ms');
            el.classList.add('revelado');
            io.unobserve(el);
          }
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        // El eje del giro depende de lo que sea la pieza: el rótulo se cuelga por el canto
        // izquierdo, las piezas sueltas entran de más lejos, el texto apenas se inclina.
        const PIEZAS = '.caja, .tarjeta, .navidad__item, .figura, .consejo__honor-item, .distintivos__col, .libros__item, .disp__item, .clases__item, .placa, .documento';
        let enPantalla = 0;
        elegidos.forEach((el) => {
          el.classList.add('revela');
          if (el.matches('.rotulo')) el.classList.add('revela--rotulo');
          else if (el.matches(PIEZAS)) el.classList.add('revela--pieza');
          // Lo que ya se ve al cargar entra en el acto: esperar al observador dejaría la
          // primera pantalla en blanco durante unos fotogramas. El escalonamiento de entrada
          // es más corto que el del desplazamiento: nadie debe esperar a poder leer.
          if (el.getBoundingClientRect().top < innerHeight) {
            el.style.setProperty('--retraso', Math.min(enPantalla++ * 55, 220) + 'ms');
            el.classList.add('revelado');
          } else io.observe(el);
        });
      }

      // Las piezas se inclinan hacia el puntero, como un objeto apoyado que se levanta por un canto.
      if (matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const GRADO = 11;
        document.querySelectorAll<HTMLElement>('main .tarjeta__enlace, main .navidad__enlace').forEach((pieza) => {
          pieza.classList.add('pieza-3d');
          let pedido = 0;
          pieza.addEventListener('pointerenter', () => pieza.classList.add('esta-inclinada'));
          pieza.addEventListener('pointermove', (e) => {
            if (pedido) return;
            pedido = requestAnimationFrame(() => {
              pedido = 0;
              const r = pieza.getBoundingClientRect();
              const x = (e.clientX - r.left) / r.width - 0.5;
              const y = (e.clientY - r.top) / r.height - 0.5;
              pieza.style.transform = `perspective(760px) rotateY(${x * GRADO}deg) rotateX(${-y * GRADO}deg) translateZ(8px)`;
            });
          });
          pieza.addEventListener('pointerleave', () => {
            if (pedido) { cancelAnimationFrame(pedido); pedido = 0; }
            pieza.classList.remove('esta-inclinada');
            pieza.style.transform = '';
          });
        });
      }

      // La venera es una medalla, no un dibujo. Allí donde se presenta como pieza (cualquier
      // [data-giro]) da un tercio de vuelta (120°) sobre sí misma atado al desplazamiento: empieza al
      // asomar por abajo y la termina, frenando, cuando su centro llega al 45 % de la ventana;
      // desde ahí queda quieta y derecha, se siga bajando o no. Al subir deshace la vuelta.
      // Un reflejo le cruza la plata en cada diagonal. Si el ratón traza círculos sobre ella, la sigue y se recuesta hacia él;
      // al salir se asienta en el cuarto de vuelta más cercano.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLElement>('[data-giro]').forEach((emblema) => {
          let giroZ = 0, mano = 0, manoObjetivo = 0, anguloPrevio: number | null = null;
          let cantoX = 0, cantoY = 0, cantoXObjetivo = 0, cantoYObjetivo = 0;
          // Se mide la escena y no la medalla: el rectángulo de la medalla girada crece en las
          // diagonales y realimentaría el giro.
          const escena = emblema.parentElement!;
          const calcularScroll = () => {
            const r = escena.getBoundingClientRect();
            // p = 0 al asomar el canto superior; 1 con el centro al 45 % de la ventana
            const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight * 0.55 + r.height / 2)));
            giroZ = -120 * Math.pow(1 - p, 2);
            emblema.style.opacity = String(0.25 + 0.75 * Math.min(1, p * 3.5));
            emblema.style.setProperty('--brillo', (Math.pow(Math.sin(giroZ * Math.PI / 90), 2) * 0.3).toFixed(3));
          };
          const pintar = () => {
            calcularScroll();
            mano += (manoObjetivo - mano) * 0.12;
            cantoX += (cantoXObjetivo - cantoX) * 0.09;
            cantoY += (cantoYObjetivo - cantoY) * 0.09;
            emblema.style.transform = `rotateX(${cantoX.toFixed(2)}deg) rotateY(${cantoY.toFixed(2)}deg) rotateZ(${(giroZ + mano).toFixed(2)}deg)`;
            requestAnimationFrame(pintar);
          };
          requestAnimationFrame(pintar);
          emblema.addEventListener('pointermove', (e) => {
            const r = emblema.getBoundingClientRect();
            const a = Math.atan2(e.clientY - (r.top + r.height / 2), e.clientX - (r.left + r.width / 2)) * 180 / Math.PI;
            if (anguloPrevio !== null) {
              let d = a - anguloPrevio;
              if (d > 180) d -= 360; else if (d < -180) d += 360;
              manoObjetivo += d / 5; // giro suave: la venera gira cinco veces menos que el ratón
            }
            anguloPrevio = a;
            cantoYObjetivo = ((e.clientX - (r.left + r.width / 2)) / (r.width / 2)) * 9;
            cantoXObjetivo = -((e.clientY - (r.top + r.height / 2)) / (r.height / 2)) * 9;
          });
          emblema.addEventListener('pointerleave', () => {
            anguloPrevio = null;
            manoObjetivo = Math.round(manoObjetivo / 90) * 90;
            cantoXObjetivo = cantoYObjetivo = 0;
          });
        });
      }

      // Enlaces con espada: mientras la espada avanza suelta un rastro continuo de tinta que el
      // "viento" arrastra hacia atrás. El subrayado lo forman sólo esas gotas: crece exactamente
      // hasta donde ha caído la última, de modo que ninguna se pierde.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLElement>('.enlace-mayor').forEach((enlace) => {
          enlace.classList.add('con-tinta');
          let activo = false;
          let ronda = 0;
          let revelado = 0;
          let ultimaX = 0;
          const revelar = (px: number) => { revelado = px; enlace.style.setProperty('--revelado', px + 'px'); };
          const gotear = () => {
            if (!activo) return;
            const espada = getComputedStyle(enlace, '::after');
            const x = parseFloat(espada.left);
            const ancho = parseFloat(espada.width);
            const inicio = parseFloat(getComputedStyle(enlace, '::before').left);
            const largo = enlace.offsetWidth - 2 * inicio;
            // Gotas según el recorrido (una cada ~1,5 px), no según el tiempo: cuando la espada frena
            // al final no se acumula tinta. Pasado el fin del texto deja de gotear y el trazo se completa.
            if (x + ancho * 0.35 - 5 > inicio + largo) {
              activo = false;
              const mia = ronda;
              setTimeout(() => { if (mia === ronda) revelar(largo); }, 300);
              return;
            }
            if (x - ultimaX >= 1.5) {
              ultimaX = x;
              const y0 = parseFloat(espada.top) + parseFloat(espada.height) / 2;
              const x0 = x + ancho * (0.35 + Math.random() * 0.6);
              const destino = x0 - (5 + Math.random() * 9);
              if (destino >= inicio && destino <= inicio + largo) {
                const tam = 3.4 + Math.random() * 2;
                const gota = document.createElement('span');
                gota.className = 'enlace-mayor__gota';
                gota.style.cssText = `left:${x0}px;top:${y0}px;width:${tam}px;height:${tam}px`;
                enlace.appendChild(gota);
                const dx = destino - x0;
                const dy = enlace.offsetHeight - 5.5 - y0;
                const mia = ronda;
                gota.animate([
                  { transform: 'translate(0, 0) scale(1)' },
                  { transform: `translate(${dx * 0.5}px, ${dy * 0.45}px) scale(.75, 3)`, offset: 0.5 },
                  { transform: `translate(${dx}px, ${dy}px) scale(1.4, .5)` },
                ], { duration: 230 + Math.random() * 90, easing: 'cubic-bezier(.4, 0, .7, 1)' }).onfinish = () => {
                  if (mia === ronda) revelar(Math.max(revelado, destino - inicio + 1));
                  gota.remove();
                };
              }
            }
            if (x < enlace.offsetWidth - ancho - 1) requestAnimationFrame(gotear);
            else activo = false;
          };
          const empezar = () => {
            if (activo) return;
            ronda++; activo = true; ultimaX = 0;
            enlace.classList.remove('recogiendo');
            revelar(0);
            requestAnimationFrame(gotear);
          };
          const parar = () => {
            ronda++; activo = false;
            enlace.querySelectorAll('.enlace-mayor__gota').forEach((g) => g.remove());
            enlace.classList.add('recogiendo');
            revelar(0);
          };
          enlace.addEventListener('pointerenter', empezar);
          enlace.addEventListener('focus', empezar);
          enlace.addEventListener('pointerleave', parar);
          enlace.addEventListener('blur', parar);
        });
      }

      // Toques de la espada: en reposo, la espada de cada enlace mayor da dos toques con la punta
      // en la primera letra, con una pausa breve entre ellos, cada 3,5 s. Si una sección tiene
      // varios, se turnan: toca uno, pasan 3,5 s y toca el siguiente. Al apuntar, la espada deja
      // de tocar y hace su recorrido; al salir retoma su turno, en fase con los demás.
      // Va con translate, no con left, que es lo que mueve el recorrido y lo que leen las gotas.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'animate' in Element.prototype) {
        const TURNO = 3500;
        // Instantes (ms) dentro del turno: primer toque, retroceso, fin de la pausa, segundo toque y vuelta
        const T = { toque1: 160, atras: 300, espera: 592, toque2: 712, fin: 972 };
        const golpe = 'cubic-bezier(.55, 0, .9, .5)', rebote = 'cubic-bezier(.2, .6, .4, 1)';
        const origen = Number(document.timeline.currentTime ?? performance.now());
        const porSeccion = new Map<Element, HTMLElement[]>();
        document.querySelectorAll<HTMLElement>('.enlace-mayor').forEach((enlace) => {
          const seccion = enlace.closest('section') ?? document.body;
          if (!porSeccion.has(seccion)) porSeccion.set(seccion, []);
          porSeccion.get(seccion)!.push(enlace);
        });
        porSeccion.forEach((lista) => lista.forEach((enlace, i) => {
          const periodo = TURNO * lista.length;
          const en = (ms: number) => ms / periodo;
          // La punta queda a 1 px de la letra: el hueco entre espada y texto, menos ese píxel
          const toca = `${(parseFloat(getComputedStyle(enlace).getPropertyValue('--hueco')) || 16) - 1}px 0`;
          const fotogramas: Keyframe[] = [
            { offset: 0, translate: '0 0', easing: golpe },
            { offset: en(T.toque1), translate: toca, easing: rebote },
            { offset: en(T.atras), translate: '5px 0' },
            { offset: en(T.espera), translate: '5px 0', easing: golpe },
            { offset: en(T.toque2), translate: toca, easing: rebote },
            { offset: en(T.fin), translate: '0 0' },
            { offset: 1, translate: '0 0' },
          ];
          let toque: Animation | null = null;
          const tocar = () => {
            toque = enlace.animate(fotogramas, { duration: periodo, iterations: Infinity, pseudoElement: '::after' });
            toque.startTime = origen + i * TURNO;
          };
          const callar = () => { toque?.cancel(); toque = null; };
          tocar();
          enlace.addEventListener('pointerenter', callar);
          enlace.addEventListener('focus', callar);
          enlace.addEventListener('pointerleave', () => { if (!toque && document.activeElement !== enlace) tocar(); });
          enlace.addEventListener('blur', () => { if (!toque && !enlace.matches(':hover')) tocar(); });
        }));
      }
    </script>
  </body>
</html>
