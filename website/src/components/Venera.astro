---
/* La venera de la Corporación, dibujada sobre la retícula de 100 u del sistema visual.
   variante: color (rojo + plata), negativo (sobre negro), mono (negro + pergamino). */
interface Props { tamano?: number | string; variante?: 'color' | 'mono'; animada?: boolean; titulo?: string; clase?: string }
const { tamano = 64, variante = 'color', animada = false, titulo, clase = '' } = Astro.props;
const cruz = variante === 'mono' ? 'var(--negro)' : 'var(--rojo)';
const espada = variante === 'mono' ? 'var(--pergamino)' : 'var(--espada)';
const ESPADA = 'M50 7.4a2.4 2.4 0 1 1 0 4.8a2.4 2.4 0 1 1 0-4.8ZM48.9 12h2.2v5h-2.2ZM43 17h14v2.2H43ZM48.4 19.2h3.2V39L50 44l-1.6-5Z';
const tam = typeof tamano === 'number' ? `${tamano}px` : tamano;
---
<svg
  class:list={['venera', clase, { 'venera--animada': animada }]}
  viewBox="0 0 100 100" width={tam} height={tam}
  role={titulo ? 'img' : undefined} aria-hidden={titulo ? undefined : 'true'} aria-label={titulo}
  data-venera={animada ? '' : undefined}
>
  <path d="M36 4H64V36H96V64H64V96H36V64H4V36H36Z" fill={cruz} />
  <g fill={espada}>
    {[0, 90, 180, 270].map((r) => (
      <g transform={`rotate(${r} 50 50)`}><path class="venera__espada" d={ESPADA} /></g>
    ))}
  </g>
</svg>

<style>
  .venera { flex: none; overflow: visible; }
  /* Un único momento: las cuatro espadas se recogen hacia el centro al entrar en pantalla */
  .venera--animada .venera__espada { transform: translateY(-9px); opacity: 0; transition: transform 1.1s cubic-bezier(.2, .7, .1, 1), opacity .6s ease; }
  .venera--animada.esta-visible .venera__espada { transform: none; opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .venera--animada .venera__espada { transform: none; opacity: 1; }
  }
</style>
