---
/* Encabezado común de las páginas de Historia: imagen velada a pantalla completa con el H1 dentro,
   que se funde con una franja oscura antes del contenido. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { titulo: string; imagen: ImageMetadata; alt: string; posicion?: string }
const { titulo, imagen, alt, posicion = '50% 45%' } = Astro.props;
---
<section class="hportada sobre-negro" aria-labelledby="historia-titulo">
  <Image class="hportada__foto" src={imagen} alt={alt} widths={[960, 1600, 2400]} sizes="100vw" quality={88} loading="eager" fetchpriority="high" style={`object-position: ${posicion}`} />
  <div class="hportada__velo" aria-hidden="true"></div>
  <div class="envoltura hportada__contenido">
    <p class="rotulo__etiqueta hportada__antetitulo">Historia</p>
    <h1 id="historia-titulo" class="hportada__titulo">{titulo}</h1>
  </div>
</section>
<div class="hcab-franja banda-negra" aria-hidden="true"></div>

<style>
  /* Sube por detrás de la cabecera (barra + filete; los márgenes negativos colapsan, no se suman) */
  .hportada { margin-top: calc(-1 * var(--cabecera) - 12px); position: relative; min-height: 100svh; display: grid; place-items: center; overflow: hidden; background: var(--negro); color: var(--pergamino); text-align: center; }
  .hportada :global(.hportada__foto) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Como en la portada: la imagen se oscurece y se funde con el negro de la franja siguiente */
  .hportada__velo { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(26, 23, 20, .5) 0%, rgba(26, 23, 20, .32) 36%, rgba(26, 23, 20, .42) 66%, rgba(26, 23, 20, .78) 88%, var(--negro) 100%); }
  .hportada__contenido { position: relative; display: grid; justify-items: center; gap: var(--s5); padding-top: var(--s8); padding-bottom: var(--s8); }
  .hportada__antetitulo { color: var(--plata); }
  .hportada__titulo { font-family: var(--f-display); font-size: clamp(52px, 8vw, 112px); line-height: 1; letter-spacing: -.01em; text-wrap: balance; max-width: 14ch; }

  /* Misma altura que tenía la entrada de La Corporación (relleno + dos líneas de texto) */
  .hcab-franja { height: 90px; }
  @media (min-width: 960px) { .hcab-franja { height: 141px; } }
</style>
