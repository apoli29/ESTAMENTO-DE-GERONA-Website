---
import Logo from './Logo.astro';
const actual = Astro.url.pathname;
const enHistoria = actual.startsWith('/historia');
// Donde la página abre con fotografía a sangre, la cabecera se esconde sobre la imagen y entra
// al primer desplazamiento: la portada y las dos de Historia (/historia/<obra>/). Los textos
// íntegros cuelgan un nivel más abajo y abren sobre negro, así que conservan la cabecera fija.
const ruta = actual.endsWith('/') ? actual : actual + '/';
const enPortada = ruta === '/' || /^\/historia\/[^/]+\/$/.test(ruta);
const navegacion = [
  { nombre: 'Actividades', href: '/actividades/' },
  { nombre: 'Consejo', href: '/#consejo' },
  { nombre: 'Enlaces', href: '/enlaces/' },
  { nombre: 'Contacto', href: '/contacto/' },
];
const activo = (href: string) => href !== '/#consejo' && actual.startsWith(href);
---
<header class:list={['cabecera', 'sobre-negro', { 'cabecera--portada': enPortada }]} data-cabecera>
  <div class="cabecera__caja">
  <div class="envoltura"><div class="cabecera__barra">
    <a class="cabecera__logo" href="/" aria-label="Inicio">
      <Logo version="horizontal-negativo" ancho={232} />
    </a>

    <button class="cabecera__menu" type="button" aria-expanded="false" aria-controls="navegacion" data-menu>
      <span class="cabecera__menu-icono" aria-hidden="true"><span></span><span></span></span>
      <span class="cabecera__menu-texto">Menú</span>
    </button>

    <nav id="navegacion" class="nav" aria-label="Principal" data-lenis-prevent>
      <ul class="nav__lista">
        <li class="nav__item nav__item--grupo">
          <button class="nav__enlace" type="button" aria-expanded="false" aria-controls="sub-historia" data-submenu aria-current={enHistoria ? 'page' : undefined}>
            Historia
            <svg class="nav__flecha" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>
          </button>
          <ul id="sub-historia" class="nav__sub">
            <li><a href="/historia/la-corporacion/" aria-current={actual.startsWith('/historia/la-corporacion') ? 'page' : undefined}>La Corporación</a></li>
            <li><a href="/historia/la-cofradia/" aria-current={actual.startsWith('/historia/la-cofradia') ? 'page' : undefined}>La Cofradía de San Jorge</a></li>
          </ul>
        </li>
        {navegacion.map((n) => (
          <li class="nav__item"><a class="nav__enlace" href={n.href} aria-current={activo(n.href) ? 'page' : undefined}>{n.nombre}</a></li>
        ))}
      </ul>
    </nav>
  </div></div>
  <div class="cabecera__banda" aria-hidden="true"><div class="filete"></div></div>
  </div>
</header>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-menu]');
  const nav = document.getElementById('navegacion');
  boton?.addEventListener('click', () => {
    const abierto = boton.getAttribute('aria-expanded') === 'true';
    boton.setAttribute('aria-expanded', String(!abierto));
    nav?.classList.toggle('esta-abierta', !abierto);
    document.body.classList.toggle('menu-abierto', !abierto);
    // Al abrir el panel, la espada del tema activo vuelve a recorrer su rótulo: con el menú
    // cerrado la animación se consume sin que nadie llegue a verla.
    if (!abierto) {
      const activo = nav?.querySelector<HTMLElement>("[aria-current='page']");
      activo?.getAnimations?.({ subtree: true }).forEach((a) => { a.cancel(); a.play(); });
    }
  });
  // "Consejo" no es una página sino una sección de la portada, así que no puede marcarse desde
  // la ruta como las demás: se enciende cuando esa sección cruza el centro de la pantalla. Al
  // empezar a cumplirse el selector, la espada arranca sola (la anima el CSS).
  const enlaceConsejo = document.querySelector<HTMLElement>('.nav__enlace[href="/#consejo"]');
  const seccionConsejo = document.getElementById('consejo');
  if (enlaceConsejo && seccionConsejo && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) enlaceConsejo.setAttribute('aria-current', 'page');
      else enlaceConsejo.removeAttribute('aria-current');
      // La sección es más alta que la ventana: se mira la banda central, no el solapamiento.
    }, { threshold: 0, rootMargin: '-45% 0px -45% 0px' }).observe(seccionConsejo);
  }

  // Portada: la cabecera aparece al desplazarse hacia abajo y vuelve a ocultarse al regresar arriba del todo.
  const cabecera = document.querySelector<HTMLElement>('.cabecera--portada');
  if (cabecera) {
    const mostrar = () => cabecera.classList.toggle('esta-visible', window.scrollY > 8);
    mostrar();
    window.addEventListener('scroll', mostrar, { passive: true });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-submenu]').forEach((b) => {
    const item = b.closest('.nav__item');
    const set = (v: boolean) => { b.setAttribute('aria-expanded', String(v)); item?.classList.toggle('esta-abierto', v); };
    b.addEventListener('click', () => set(b.getAttribute('aria-expanded') !== 'true'));
    item?.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Escape') { set(false); b.focus(); } });
    document.addEventListener('click', (e) => { if (item && !item.contains(e.target as Node)) set(false); });
  });
</script>

<style>
  /* La cabecera ocupa el ancho de la ventana; el contenido se alinea a la retícula de la página */
  .cabecera { position: sticky; top: 0; z-index: 30; color: var(--pergamino); margin-bottom: -12px; }
  .cabecera__caja { position: relative; background: linear-gradient(var(--castano), var(--castano)) top / 100% calc(100% - 12px) no-repeat; }
  .cabecera--portada {
    position: fixed; left: 0; right: 0;
    transform: translateY(-100%); opacity: 0; pointer-events: none;
    transition: transform .9s cubic-bezier(.2, .7, .1, 1), opacity .6s ease;
  }
  .cabecera--portada.esta-visible, .cabecera--portada:focus-within {
    transform: none; opacity: 1; pointer-events: auto;
  }
  /* Mismo aire arriba y abajo del logotipo, hasta el filete */
  /* El relleno lateral ya lo da la envoltura: el logotipo cae a plomo con el contenido */
  .cabecera__barra { display: flex; align-items: center; justify-content: space-between; gap: var(--s5); height: var(--cabecera); }
  .cabecera__logo { display: flex; }
  .cabecera__banda { position: relative; z-index: 2; }
  .cabecera__logo :global(svg) { width: 200px; }
  @media (min-width: 1100px) { .cabecera__logo :global(svg) { width: 232px; } }

  .cabecera__menu {
    display: inline-flex; align-items: center; gap: var(--s3); min-height: 44px; padding: 0 var(--s2);
    background: none; border: 0; color: var(--pergamino); font: 500 12px/1 var(--f-sans); letter-spacing: .16em; text-transform: uppercase; cursor: pointer;
  }
  .cabecera__menu-icono { display: grid; gap: 6px; width: 22px; }
  .cabecera__menu-icono span { height: 1.5px; background: currentColor; transition: transform .25s ease; }
  .cabecera__menu[aria-expanded='true'] .cabecera__menu-icono span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .cabecera__menu[aria-expanded='true'] .cabecera__menu-icono span:last-child { transform: translateY(-3.75px) rotate(-45deg); }

  .nav__lista { list-style: none; }
  .nav__enlace {
    position: relative;
    display: inline-flex; align-items: center; gap: var(--s2); padding: var(--s3) 0;
    background: none; border: 0; cursor: pointer;
    font: 500 12px/16px var(--f-sans); letter-spacing: .16em; text-transform: uppercase;
    color: var(--pergamino); text-decoration: none; border-bottom: 1px solid transparent;
    transition: color .25s ease;
  }
  .nav__enlace:hover { color: var(--plata); }

  /* El tema activo se subraya con la espada del sistema: el filo recorre el rótulo de izquierda
     a derecha y la línea se dibuja detrás de él. El borde se queda transparente para reservar
     el sitio y que nada salte al cambiar de página. */
  .nav__enlace[aria-current='page'] { color: var(--pergamino); border-bottom-color: transparent; }
  .nav__enlace[aria-current='page']::after {
    content: ''; position: absolute; left: 0; bottom: -1px; width: 100%; height: 1px;
    background: var(--pergamino);
    transform: scaleX(0); transform-origin: left;
    /* Misma cadencia que la espada de .enlace-mayor: un trazo decidido, no un rebote */
    animation: nav-linea .9s cubic-bezier(.65, 0, .35, 1) forwards;
  }
  .nav__enlace[aria-current='page']::before {
    content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 11px;
    background: var(--pergamino);
    -webkit-mask: var(--espada-h) left center / 22px 11px no-repeat;
    mask: var(--espada-h) left center / 22px 11px no-repeat;
    animation: nav-espada .9s cubic-bezier(.65, 0, .35, 1) forwards;
  }
  @keyframes nav-linea { to { transform: scaleX(1); } }
  @keyframes nav-espada {
    from { -webkit-mask-position: left center; mask-position: left center; }
    to { -webkit-mask-position: right center; mask-position: right center; }
  }
  .nav__flecha { transition: transform .2s ease; }
  .nav__item.esta-abierto .nav__flecha { transform: rotate(180deg); }
  .nav__sub { list-style: none; }
  .nav__sub a { display: block; font-family: var(--f-texto); font-size: 18px; color: var(--pergamino); text-decoration: none; padding: var(--s2) 0; }
  .nav__sub a:hover { color: var(--plata); }
  .nav__sub a[aria-current='page']::before { content: ''; display: inline-block; width: 16px; height: 1px; background: currentColor; vertical-align: middle; margin-right: var(--s2); }

  /* Móvil y tableta: panel desplegable bajo la cabecera */
  @media (max-width: 1023px) {
    .nav { display: none; position: absolute; left: 0; right: 0; top: calc(100% - 12px); padding-top: 12px; background: var(--castano); border-bottom: 12px solid var(--negro); max-height: calc(100vh - 100px); overflow: auto; }
    .nav.esta-abierta { display: block; }
    .nav__lista { padding: var(--s5) var(--margen) var(--s7); }
    .nav__item { border-bottom: 1px solid var(--linea-clara); }
    .nav__enlace { width: 100%; justify-content: space-between; padding: var(--s4) 0; font-size: 13px; }
    .nav__sub { display: none; padding: 0 0 var(--s4) var(--s4); }
    .nav__item.esta-abierto .nav__sub { display: block; }
  }
  /* Escritorio */
  @media (min-width: 1024px) {
    .cabecera__menu { display: none; }
    .nav__lista { display: flex; gap: var(--s6); align-items: center; }
    .nav__item--grupo { position: relative; }
    .nav__sub {
      display: none; position: absolute; top: calc(100% + 14px); left: -24px; min-width: 300px;
      background: var(--castano); border: 1px solid var(--linea-clara); border-top: 2px solid var(--teja); padding: var(--s3) var(--s5);
    }
    .nav__item.esta-abierto .nav__sub { display: block; }
    .nav__sub li + li { border-top: 1px solid var(--linea-clara); }
  }
</style>
<noscript><style>.cabecera--portada { transform: none; opacity: 1; pointer-events: auto; }</style></noscript>
